# =====================================================================
# find-it-campus · Windows 部署环境配置模板
#
# 本文件由 build-package.ps1 原样打进部署包；install.ps1 会把 __XXX__ 占位符
# 替换为真实值并生成同目录的 deploy.env.ps1。
#
# 安全约定：
#   - deploy.env.ps1 含真实数据库密码，只允许留在部署包内，绝不能提交到 git。
#   - 本模板不含任何真实密码，可以进仓库。
# =====================================================================

# 供 install / status / stop 复用的连接元数据（不打印密码）
$DeployDbHost  = '__DB_HOST__'
$DeployDbPort  = __DB_PORT__
$DeployDbName  = '__DB_NAME__'
$DeployDbUser  = '__DB_USER__'
$DeployMysqlBin = '__MYSQL_BIN__'
$DeployJavaBin  = '__JAVA_BIN__'
$DeployEngine   = '__ENGINE__'

# 后端只认这些环境变量（见 server/src/main/resources/application.yml）：
# FINDIT_DB_URL / FINDIT_DB_USER / FINDIT_DB_PASSWORD / FINDIT_MATCH_ENGINE
$env:FINDIT_DB_URL = 'jdbc:mysql://__DB_HOST__:__DB_PORT__/__DB_NAME__?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&connectTimeout=3000&socketTimeout=10000'
$env:FINDIT_DB_USER = '__DB_USER__'
$env:FINDIT_DB_PASSWORD = '__DB_PASSWORD__'
$env:FINDIT_MATCH_ENGINE = '__ENGINE__'

# 仅 FINDIT_MATCH_ENGINE=external 时需要；local 引擎保持空串。
# 注意：install.ps1 不会询问这两个凭据，如使用 external 请在本文件生成后手工填写。
$env:FINDIT_EMBED_BASE_URL = ''
$env:FINDIT_EMBED_API_KEY = ''
