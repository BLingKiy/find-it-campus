# 依赖与构建产物
node_modules/
target/
dist/
build/

# Node
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 日志与临时文件
*.log
*.tmp
*.swp

# IDE / 编辑器
.idea/
.vscode/
*.iml

# Maven Wrapper：脚本与 properties 必须提交，只忽略下载的二进制
# （server/.mvn/wrapper/maven-wrapper.properties 不要加到这里）
.mvn/wrapper/maven-wrapper.jar

# 本机私密配置：用 application-example.yml / .env.example 复制生成，不进仓库
server/src/main/resources/application-local.yml
.env
.env.*
!.env.example

# 课件原始素材（仓库初始化时已有）
/TheClassMaterial/

# 7.1 Windows 部署包：构建缓存、staging、zip 产物不入库
deploy/.cache/
deploy/.staging/
deploy/dist/

# install.ps1 生成的真实连接配置（含数据库密码），绝不提交
deploy/config/deploy.env.ps1
deploy/**/config/deploy.env.ps1
