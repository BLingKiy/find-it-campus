# 复制到 .env.local 后按需修改（.env.local 不提交）
# 开发期默认走 Vite 代理：浏览器同源 /api → Vite → http://localhost:18080
# 若前端直连后端，改成 http://localhost:18080/api（此时依赖后端 CORS，见架构基线 §9.4）
VITE_API_BASE_URL=/api

# 前端 mock 开关：true = listRecords 走 web/src/mock/records.ts 的样例数据；
# false 或不设置（默认）= 走真实 GET /api/records。
# TODO(4.1): ZHYYKFX-8（4.1 页面接通后端）后删除本项与对应分支；
# 若 4.1 决定保留开关供答辩演示，须在 4.1 明确写出保留理由。
VITE_USE_MOCK=false
